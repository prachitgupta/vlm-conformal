# Obstacle avoidance persistent launch settings for PX4 + Gazebo Harmonic.
# Source this file from a shell script or terminal.

export PX4_GZ_WORLD=obstacle_avoidance
# Allow launchers to override the model.
# Default to depth variant because full-stack bridge expects OakD topics.
export PX4_SIM_MODEL="${PX4_SIM_MODEL:-gz_x500_depth}"
export PX4_GZ_MODEL_POSE="0,0,1.0,0,0,0"

# Optional: tune home geolocation (defaults are from world file if unset).
# export PX4_HOME_LAT=47.397971057728974
# export PX4_HOME_LON=8.546163739800146
# export PX4_HOME_ALT=0
